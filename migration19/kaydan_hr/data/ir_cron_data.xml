<?xml version="1.0" encoding="utf-8"?>
<!-- PORTAGE ODOO 19 : le cron s'exécute désormais sur hr.employee
     (hr.contract n'existe plus ; les contrats sont des hr.version déléguées
     depuis l'employé). Le XMLID base.model_hr_employee remplace
     hr_contract.model_hr_contract. -->
<odoo>
    <record id="ir_cron_contract_alerts" model="ir.cron">
        <field name="name">Kaydan RH : alertes contrats (CDD / période d'essai)</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_contract_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
